generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id            String    @id @default(cuid())
  nameAr        String
  nameEn        String
  slug          String    @unique
  descriptionAr String?
  descriptionEn String?
  image         String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  products      Product[]

  @@index([isActive])
}

model Brand {
  id        String    @id @default(cuid())
  nameAr    String
  nameEn    String
  slug      String    @unique
  logo      String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@index([isActive])
}

model Product {
  id                String         @id @default(cuid())
  nameAr            String
  nameEn            String
  slug              String         @unique
  sku               String?        @unique
  descriptionAr     String?
  descriptionEn     String?
  price             Decimal        @db.Decimal(10, 2)
  oldPrice          Decimal?       @db.Decimal(10, 2)
  stock             Int            @default(0)
  isActive          Boolean        @default(true)
  isFeatured        Boolean        @default(false)
  isBestSeller      Boolean        @default(false)
  categoryId        String
  brandId           String?
  metaTitleAr       String?
  metaTitleEn       String?
  metaDescriptionAr String?
  metaDescriptionEn String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  brand             Brand?         @relation(fields: [brandId], references: [id])
  category          Category       @relation(fields: [categoryId], references: [id])
  images            ProductImage[]
  stockMovements StockMovement[]
  @@index([categoryId])
  @@index([brandId])
  @@index([isActive])
  @@index([isBestSeller])
  @@index([isFeatured])
  @@index([createdAt])
}

model ProductImage {
  id        String   @id @default(cuid())
  url       String
  altAr     String?
  altEn     String?
  sortOrder Int      @default(0)
  productId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ShippingRate {
  id         String   @id @default(cuid())
  code       String   @unique
  nameAr     String
  nameEn     String
  price      Decimal  @db.Decimal(10, 2)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}


model Order {
  id             String        @id @default(cuid())
  orderNumber    String        @unique

  // Prevent duplicate checkout requests
  checkoutKey    String?       @unique
  checkoutPayloadHash String?

  // Customer information
  customerName   String
  phone          String
  alternatePhone String?
  governorate    String
  city           String
  address        String        @db.Text
  notes          String?       @db.Text

  // Pricing
  subtotal       Decimal       @db.Decimal(10, 2)
  shippingFee    Decimal       @db.Decimal(10, 2)
  total          Decimal       @db.Decimal(10, 2)

  // Payment and order status
  paymentMethod  PaymentMethod
  paymentStatus  PaymentStatus @default(PENDING)
  status         OrderStatus   @default(PENDING_PAYMENT)

  // Relations
  items          OrderItem[]
  stockDeductedAt DateTime?
  stockRestoredAt DateTime?

  refundStatus RefundStatus @default(NONE)
  refundedAt   DateTime?
  refundNote   String?      @db.Text

  stockMovements StockMovement[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([createdAt])
  @@index([status])
  @@index([paymentStatus])
}


model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId   String
  productSlug String
  productName String
  quantity    Int
  unitPrice   Decimal @db.Decimal(10, 2)
  total       Decimal @db.Decimal(10, 2)

  @@index([orderId])
}

enum PaymentMethod {
  VODAFONE_CASH
  INSTAPAY
}

enum PaymentStatus {
  PENDING
  UNDER_REVIEW
  PAID
  REJECTED
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}
model CheckoutRateLimit {
  key       String   @id
  count     Int      @default(0)
  createdAt DateTime @default(now())
}


model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model StoreSettings {
  id                  String   @id @default("main")
  storeNameAr         String   @default("وسامة برفيوم")
  storeNameEn         String   @default("Wasama Perfume")
  whatsapp            String   @default("")
  vodafoneCashNumber  String   @default("")
  instapayAddress     String   @default("")
  vodafoneCashEnabled Boolean  @default(false)
  instapayEnabled     Boolean  @default(false)
  paymentInstructions String   @default("") @db.Text
  updatedAt           DateTime @updatedAt
}

enum RefundStatus {
  NONE
  PENDING
  COMPLETED
}

enum StockMovementType {
  SALE
  RETURN
}

model StockMovement {
  id        String            @id @default(cuid())
  orderId   String
  productId String
  type      StockMovementType
  quantity  Int
  createdAt DateTime          @default(now())

  order     Order   @relation(fields: [orderId], references: [id])
  product   Product @relation(fields: [productId], references: [id])

  @@unique([orderId, productId, type])
  @@index([productId])
  @@index([createdAt])
}